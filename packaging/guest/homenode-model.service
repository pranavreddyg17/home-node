[Unit]
Description=HomeNode development CPU inference server
Requires=systemd-tmpfiles-setup.service tmp.mount var.mount
After=systemd-tmpfiles-setup.service tmp.mount var.mount
ConditionPathExists=/usr/lib/homenode/ai/llama-server
ConditionPathExists=/usr/lib/homenode/ai/model.gguf

[Service]
Type=simple
DynamicUser=yes
User=homenode-model
Group=homenode-model
ExecStart=/usr/lib/homenode/ai/llama-server --model /usr/lib/homenode/ai/model.gguf --offline --host 127.0.0.1 --port 8080 --parallel 1 --ctx-size 512 --predict 256 --threads 2 --threads-batch 2 --batch-size 64 --ubatch-size 64 --cache-ram 0 --no-cache-prompt --no-cache-idle-slots --no-jinja --chat-template chatml --no-webui --no-slots --no-webui-mcp-proxy --log-disable --device none --gpu-layers 0 --threads-http 2 --timeout 30
Environment=LANG=C.UTF-8
UMask=0077
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
InaccessiblePaths=/data -/dev/virtio-ports
DevicePolicy=closed
MemoryMax=1G
MemorySwapMax=0
TasksMax=128
LimitNOFILE=128
LimitCORE=0

[Install]
WantedBy=multi-user.target
