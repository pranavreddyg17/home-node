[Unit]
ConditionPathExists=!/var/lib/homenode-install/recovery-blocked
Description=HomeNode controller-only backup credential listener

[Socket]
ListenSequentialPacket=/run/homenode-backup/credential.sock
FileDescriptorName=homenode-backup-credential
SocketUser=root
SocketGroup=homenode
SocketMode=0660
DirectoryMode=0755
Service=homenode-backup.service
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
