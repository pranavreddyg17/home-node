  "components": {
    "securitySchemes": {
      "OwnerSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-homenode"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "EmptyObject": {
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 0
      },
      "PairRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "capabilities"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Must contain non-whitespace text; NUL, CR and LF are refused. Runtime bounds use UTF-8 bytes."
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "admin",
                "files",
                "jobs",
                "ai"
              ]
            }
          }
        },
        "description": "Duplicate decoded keys, escaped duplicates, differently cased keys and invalid UTF-8 are refused."
      },
      "ApprovalBegin": {
        "type": "object",
        "required": [
          "options",
          "challengeToken",
          "expiresAt"
        ],
        "properties": {
          "options": {
            "type": "object",
            "required": [
              "publicKey"
            ],
            "properties": {
              "publicKey": {
                "type": "object",
                "description": "WebAuthn PublicKeyCredentialRequestOptions JSON; userVerification is required and allowCredentials contains acting-device credentials only."
              }
            }
          },
          "challengeToken": {
            "type": "string",
            "minLength": 20,
            "maxLength": 128,
            "description": "Opaque bearer value; transmit only in the designated header or JSON body. Never put in URLs or persistent browser storage."
          },
          "expiresAt": {
            "type": "integer",
            "description": "Unix seconds; original approval expiry."
          }
        }
      },
      "ApprovalGrant": {
        "type": "object",
        "required": [
          "approvalToken"
        ],
